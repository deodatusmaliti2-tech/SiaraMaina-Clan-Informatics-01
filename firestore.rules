rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, secure helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() 
        && request.auth.token.email != null 
        && request.auth.token.email.lower() == 'deodatusmaliti2@gmail.com';
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && (
        isMasterAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData(request.auth.uid).role == role)
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Attribute-Based Access Control rules for users registry
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isMasterAdmin() || isAdmin() || (
        isSignedIn() && isOwner(userId) && (
          request.resource.data.role == 'viewer' || 
          (request.resource.data.role == 'admin' && isMasterAdmin())
        )
      );
      allow update: if isMasterAdmin() || isAdmin() || (
        isOwner(userId) && (
          (request.resource.data.role == resource.data.role && request.resource.data.active == resource.data.active) ||
          (request.resource.data.role == 'admin' && isMasterAdmin())
        )
      );
      allow delete: if isMasterAdmin() || isAdmin();
    }

    // Rules for siaraMainaClan and records genealogical ledger (Single Source of Truth)
    match /siaraMainaClan/{docId} {
      allow read, write: if true;
    }

    match /records/{docId} {
      allow read, write: if true;
    }

    // Rules for individual member documents collection
    match /members/{memberId} {
      allow read, write: if true;
    }

    // Rules for shared collections: announcements, settings, courses, attendance, reports, notifications
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isMasterAdmin() || hasRole('editor');
    }
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isMasterAdmin();
    }
    match /courses/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isMasterAdmin() || hasRole('editor');
    }
    match /attendance/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isMasterAdmin() || hasRole('editor');
    }
    match /reports/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isMasterAdmin() || hasRole('editor');
    }
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Immutable Security & Activity Audit Logs
    match /ActivityLogs/{logId} {
      allow read: if isAdmin() || isMasterAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
